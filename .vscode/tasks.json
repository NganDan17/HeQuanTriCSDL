{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Chạy Health Fitness",
      "type": "process",
      "command": "powershell.exe",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/Chay.ps1"],
      "options": {"cwd": "${workspaceFolder}"},
      "group": {"kind": "build", "isDefault": true},
      "problemMatcher": "$msCompile",
      "presentation": {"reveal": "always", "panel": "dedicated", "clear": true},
      "runOptions": {"instanceLimit": 1}
    },
    {
      "label": "Chỉ biên dịch Health Fitness",
      "type": "process",
      "command": "powershell.exe",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/BienDich.ps1"],
      "options": {"cwd": "${workspaceFolder}"},
      "group": "build",
      "problemMatcher": "$msCompile"
    }
  ]
}
