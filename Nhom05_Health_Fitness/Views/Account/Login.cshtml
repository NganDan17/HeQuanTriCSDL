@{
    ViewBag.Title = "Đăng nhập";
    Layout = "~/Views/Shared/_LayoutUser.cshtml";
}

<div class="container py-5">
    <div class="row justify-content-center align-items-center" style="min-height: 60vh;">
        <div class="col-md-5">
            <div class="card shadow-lg border-0 rounded-4 overflow-hidden">
                <div class="card-header bg-brand-teal text-white text-center py-4 position-relative">
                    <h3 class="fw-bold mb-0 text-uppercase" style="letter-spacing: 2px;">Đăng Nhập</h3>
                    <p class="small opacity-75 mb-0">Chào mừng bạn quay trở lại M-GYM</p>
                    
                    <div class="position-absolute top-0 start-0 p-3 opacity-25">
                        <i class="fas fa-dumbbell fa-3x text-white"></i>
                    </div>
                </div>

                <div class="card-body p-5 bg-white">
                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success small"><i class="fas fa-check-circle me-1"></i> @TempData["Success"]</div>
                    }
                    @if (ViewBag.Error != null)
                    {
                        <div class="alert alert-danger small"><i class="fas fa-exclamation-triangle me-1"></i> @ViewBag.Error</div>
                    }

                    @using (Html.BeginForm("Login", "Account", FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()

                        <div class="mb-4">
                            <label class="form-label fw-bold text-muted small">TÊN ĐĂNG NHẬP HOẶC EMAIL</label>
                            <div class="input-group input-group-lg">
                                <span class="input-group-text bg-light border-end-0 text-muted"><i class="fas fa-user"></i></span>
                                <input type="text" name="TenDangNhap" class="form-control bg-light border-start-0" placeholder="Nhập tài khoản..." required autofocus>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-bold text-muted small">MẬT KHẨU</label>
                            <div class="input-group input-group-lg">
                                <span class="input-group-text bg-light border-end-0 text-muted"><i class="fas fa-lock"></i></span>
                                <input type="password" name="MatKhau" class="form-control bg-light border-start-0" placeholder="••••••" required>
                            </div>
                        </div>

                        <div class="d-grid mb-4">
                            <button type="submit" class="btn btn-neon btn-lg shadow-sm fw-bold text-dark">ĐĂNG NHẬP NGAY</button>
                        </div>

                        <div class="text-center text-muted small">
                            Chưa có tài khoản? 
                            <a href="@Url.Action("Register", "Account")" class="text-decoration-none fw-bold" style="color: var(--brand-teal);">
                                Đăng ký miễn phí
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>