@model Nhom05_Health_Fitness.Models.UserProfileViewModel

@{
    ViewBag.Title = "Sửa thông tin Hội viên";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    string userID = ViewBag.UserID as string;
}

<div class="dashboard-header">
    <div class="title-group">
        <h2>✏️ Chỉnh Sửa Hồ Sơ</h2>
        <p>Cập nhật thông tin cá nhân cho hội viên ID: <b>@userID</b></p>
    </div>
    @* Nút Quay lại trang chi tiết *@
    <a href="@Url.Action("Admin_DanhSachHoiVien", "Admin")"
       class="btn-refresh"
       style="background-color: var(--text-secondary); color: var(--bg-dark-primary); text-decoration: none;">
        <i class="fas fa-arrow-left"></i> Hủy bỏ
    </a>
</div>

<div class="row justify-content-center" style="margin-top: 20px;">
    <div class="col-md-8">
        <div class="detail-card">

            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger" style="color: #F1416C; margin-bottom: 15px;">
                    <i class="fas fa-exclamation-triangle"></i> @ViewBag.Error
                </div>
            }

            @using (Html.BeginForm("Admin_SuaUser", "Admin", new { id = userID.Trim() }, FormMethod.Post))
            {
                @Html.AntiForgeryToken()

                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px;">

                    @* --- Cột Trái --- *@
                    <div>
                        <div class="mb-3">
                            <label class="detail-label">Họ và Tên</label>
                            @Html.TextBoxFor(m => m.HoTen, new { @class = "form-control", style = "background-color: var(--bg-dark-primary); color: white; border: 1px solid #2d3748; padding: 10px; width: 100%; border-radius: 6px;", required = "required" })
                        </div>

                        <div class="mb-3" style="margin-top: 15px;">
                            <label class="detail-label">Email</label>
                            @Html.TextBoxFor(m => m.Email, new { @class = "form-control", type = "email", style = "background-color: var(--bg-dark-primary); color: white; border: 1px solid #2d3748; padding: 10px; width: 100%; border-radius: 6px;" })
                        </div>

                        <div class="mb-3" style="margin-top: 15px;">
                            <label class="detail-label">Giới tính</label>
                            <select name="GioiTinh" class="form-control" style="background-color: var(--bg-dark-primary); color: white; border: 1px solid #2d3748; padding: 10px; width: 100%; border-radius: 6px;">
                                <option value="Nam" @(Model.GioiTinh == "Nam" ? "selected" : "")>Nam</option>
                                <option value="Nữ" @(Model.GioiTinh == "Nữ" ? "selected" : "")>Nữ</option>
                                <option value="Khác" @(Model.GioiTinh != "Nam" && Model.GioiTinh != "Nữ" ? "selected" : "")>Khác</option>
                            </select>
                        </div>
                    </div>

                    @* --- Cột Phải --- *@
                    <div>
                        <div class="mb-3">
                            <label class="detail-label">Ngày sinh</label>
                            <input type="date" name="NgaySinh"
                                   value="@(Model.NgaySinh.HasValue ? Model.NgaySinh.Value.ToString("yyyy-MM-dd") : "")"
                                   class="form-control"
                                   style="background-color: var(--bg-dark-primary); color: white; border: 1px solid #2d3748; padding: 10px; width: 100%; border-radius: 6px;" />
                        </div>

                        <div class="mb-3" style="margin-top: 15px;">
                            <label class="detail-label">Chiều cao (cm)</label>
                            @Html.TextBoxFor(m => m.ChieuCao, new { @class = "form-control", type = "number", step = "0.01", style = "background-color: var(--bg-dark-primary); color: white; border: 1px solid #2d3748; padding: 10px; width: 100%; border-radius: 6px;" })
                        </div>

                        <div class="mb-3" style="margin-top: 15px;">
                            <label class="detail-label">Cân nặng (kg)</label>
                            @Html.TextBoxFor(m => m.CanNang, new { @class = "form-control", type = "number", step = "0.01", style = "background-color: var(--bg-dark-primary); color: white; border: 1px solid #2d3748; padding: 10px; width: 100%; border-radius: 6px;" })
                        </div>
                    </div>
                </div>

                <div style="margin-top: 30px; text-align: right; border-top: 1px solid #2d3748; padding-top: 20px;">
                    <button type="submit" class="btn-refresh" style="background-color: var(--accent-gold); color: var(--bg-dark-primary); border: none; padding: 12px 30px; cursor: pointer;">
                        <i class="fas fa-save"></i> Lưu Thay Đổi
                    </button>
                </div>
            }
        </div>
    </div>
</div>