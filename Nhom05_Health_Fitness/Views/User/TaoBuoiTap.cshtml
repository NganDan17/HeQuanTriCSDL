@{
    ViewBag.Title = "Ghi nhận buổi tập mới";
    Layout = "~/Views/Shared/_LayoutUser.cshtml";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow border-0 rounded-4">
                <div class="card-header bg-brand-teal text-white text-center py-3">
                    <h4 class="fw-bold mb-0 text-uppercase"><i class="fas fa-edit me-2"></i>Ghi nhận buổi tập</h4>
                </div>
                <div class="card-body p-4">
                    <form action="@Url.Action("TaoBuoiTap", "User")" method="post">
                        <div class="mb-3">
                            <label class="form-label fw-bold text-muted">Ngày tập</label>
                            <input type="date" name="ngayTap" class="form-control" value="@DateTime.Now.ToString("yyyy-MM-dd")" required>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold text-muted">Thời lượng (phút)</label>
                            <input type="number" name="thoiLuong" class="form-control" placeholder="VD: 60" required min="1">
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-bold text-muted">Ghi chú (Tùy chọn)</label>
                            <textarea name="ghiChu" class="form-control" rows="3" placeholder="VD: Hôm nay tập Ngực, hơi mệt..."></textarea>
                        </div>

                        <div class="d-grid">
                            <button type="submit" class="btn btn-neon fw-bold text-dark">
                                TIẾP TỤC: THÊM BÀI TẬP <i class="fas fa-arrow-right ms-2"></i>
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>