@model IEnumerable<Nhom05_Health_Fitness.Models.usp_NhatKyTapLuyenResult>

@{
    ViewBag.Title = "Nhật ký tập luyện";
    Layout = "~/Views/Shared/_LayoutUser.cshtml";

    // Lấy ngày hiện tại từ ViewBag (được gán trong Controller)
    DateTime ngayHienTai = (DateTime)ViewBag.NgayHienTai;
}

<div class="container py-5">
    <div class="row align-items-center mb-4">
        <div class="col-md-6">
            <h2 class="fw-bold text-uppercase mb-0" style="color: var(--brand-teal);">
                <i class="fas fa-book-medical me-2"></i>Nhật ký tập luyện
            </h2>
            <p class="text-muted small mb-0">Theo dõi hành trình sức mạnh của bạn</p>
        </div>
        <div class="col-md-6 text-md-end mt-3 mt-md-0">
            <form action="@Url.Action("NhatKy", "User")" method="get" class="d-inline-flex align-items-center">
                <label class="me-2 fw-bold text-muted">Xem ngày:</label>
                <input type="date" name="ngayXem" class="form-control border-2 shadow-sm"
                       style="border-color: var(--brand-teal); width: auto;"
                       value="@ngayHienTai.ToString("yyyy-MM-dd")"
                       onchange="this.form.submit()">
            </form>
        </div>
    </div>

    @if (Model != null && Model.Any())
    {
        var tongThoiGian = Model.FirstOrDefault()?.ThoiLuong_phut ?? 0;
        var tongBaiTap = Model.Count();
        var tongVolume = Model.Sum(x => x.SoHiep * x.SoLanLap * (x.TrongLuongTa_kg ?? 0));

        <div class="row g-3 mb-4">
            <div class="col-md-4">
                <div class="card border-0 shadow-sm h-100" style="background-color: #e3f2fd;">
                    <div class="card-body d-flex align-items-center">
                        <div class="rounded-circle bg-white p-3 text-primary me-3">
                            <i class="fas fa-clock fa-2x"></i>
                        </div>
                        <div>
                            <small class="text-muted text-uppercase fw-bold">Thời lượng</small>
                            <h4 class="fw-bold mb-0">@tongThoiGian phút</h4>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card border-0 shadow-sm h-100" style="background-color: #fff3cd;">
                    <div class="card-body d-flex align-items-center">
                        <div class="rounded-circle bg-white p-3 text-warning me-3">
                            <i class="fas fa-dumbbell fa-2x"></i>
                        </div>
                        <div>
                            <small class="text-muted text-uppercase fw-bold">Bài tập</small>
                            <h4 class="fw-bold mb-0">@tongBaiTap bài</h4>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card border-0 shadow-sm h-100" style="background-color: #d1e7dd;">
                    <div class="card-body d-flex align-items-center">
                        <div class="rounded-circle bg-white p-3 text-success me-3">
                            <i class="fas fa-weight-hanging fa-2x"></i>
                        </div>
                        <div>
                            <small class="text-muted text-uppercase fw-bold">Tổng Volume</small>
                            <h4 class="fw-bold mb-0">@string.Format("{0:N0}", tongVolume) kg</h4>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="card border-0 shadow-sm rounded-4 mb-4" style="background: linear-gradient(to right, #0C2659, #083b45);">
            <div class="card-body p-4 text-white d-flex justify-content-between align-items-center">

                @if (ViewBag.DanhGia != null)
                {
                    // --- ĐÃ ĐÁNH GIÁ ---
                    var dg = ViewBag.DanhGia as Nhom05_Health_Fitness.Models.DanhGiaBuoiTap;
                    <div>
                        <h5 class="fw-bold text-brand-neon mb-1">
                            <i class="fas fa-check-circle me-2"></i>BUỔI TẬP ĐÃ HOÀN THÀNH
                        </h5>
                        <div class="mb-4 text-start">
                            <label class="form-label fw-bold small text-muted">
                                ĐIỂM ĐÁNH GIÁ (1 - 5)
                            </label>
                            <input type="number"
                                   name="soSao"
                                   class="form-control text-center fw-bold fs-4"
                                   min="1"
                                   max="5"
                                   value="5"
                                   required>
                            <small class="text-muted fst-italic">
                                Nhập số từ 1 đến 5 (1 = kém, 5 = rất tốt)
                            </small>
                        </div>


                        <small class="fst-italic opacity-75">"@dg.NhanXet"</small>
                    </div>
                    <div>
                        <button class="btn btn-outline-light btn-sm rounded-pill px-3" data-bs-toggle="modal" data-bs-target="#modalDanhGia">
                            Sửa đánh giá
                        </button>
                    </div>
                }
                else
                {
                    // --- CHƯA ĐÁNH GIÁ ---
                    <div>
                        <h5 class="fw-bold mb-1">BẠN CẢM THẤY THẾ NÀO?</h5>
                        <p class="mb-0 small opacity-75">Hãy đánh giá buổi tập để theo dõi hiệu suất nhé!</p>
                    </div>
                    <div>
                        <button class="btn btn-neon fw-bold text-dark px-4 shadow" data-bs-toggle="modal" data-bs-target="#modalDanhGia">
                            <i class="fas fa-star me-2"></i>ĐÁNH GIÁ NGAY
                        </button>
                    </div>
                }
            </div>
        </div>

        <div class="card shadow border-0 rounded-4 overflow-hidden">
            <div class="card-header bg-brand-teal text-white py-3">
                <h5 class="mb-0 fw-bold"><i class="fas fa-list-ul me-2"></i>Chi tiết buổi tập</h5>
            </div>
            <div class="table-responsive">
                <table class="table table-hover table-striped align-middle mb-0">
                    <thead class="bg-light text-uppercase small fw-bold text-muted">
                        <tr>
                            <th class="ps-4">Bài tập</th>
                            <th class="text-center">Hiệp (Sets)</th>
                            <th class="text-center">Lần lặp (Reps)</th>
                            <th class="text-center">Mức tạ (Kg)</th>
                            <th>Thiết bị</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4">
                                    <div class="fw-bold text-dark" style="font-size: 1.1rem;">@item.TenBaiTap</div>
                                </td>
                                <td class="text-center">
                                    <span class="badge bg-secondary rounded-pill fs-6">@item.SoHiep</span>
                                </td>
                                <td class="text-center fw-bold text-primary fs-5">@item.SoLanLap</td>
                                <td class="text-center">
                                    @if (item.TrongLuongTa_kg > 0)
                                    {
                                        <span class="fw-bold text-danger fs-5">@string.Format("{0:N1}", item.TrongLuongTa_kg)</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small fst-italic">Bodyweight</span>
                                    }
                                </td>
                                <td class="text-muted small">
                                    @(string.IsNullOrEmpty(item.TenThietBi) ? "-" : item.TenThietBi)
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    else
    {
        <div class="text-center py-5 card shadow-sm border-0 rounded-4">
            <div class="card-body">
                <div class="mb-4 opacity-50">
                    <i class="fas fa-calendar-day fa-5x" style="color: var(--brand-grey);"></i>
                </div>
                <h4 class="fw-bold text-muted">Không có dữ liệu tập luyện</h4>
                <p class="text-muted">Bạn chưa ghi nhận buổi tập nào vào ngày <strong>@ngayHienTai.ToString("dd/MM/yyyy")</strong>.</p>

                <a href="@Url.Action("TaoBuoiTap", "User")" class="btn btn-neon fw-bold px-4 mt-3 shadow-sm text-dark">
                    <i class="fas fa-plus-circle me-2"></i>Ghi nhận buổi tập mới
                </a>
            </div>
        </div>
    }
</div>

<div class="modal fade" id="modalDanhGia" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-brand-teal text-white">
                <h5 class="modal-title fw-bold">ĐÁNH GIÁ BUỔI TẬP</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form action="@Url.Action("LuuDanhGia", "User")" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="buoiTapID" value="@ViewBag.BuoiTapID" />

                <div class="modal-body p-4">

                    <div class="mb-4 text-start">
                        <label class="form-label fw-bold small text-muted">
                            ĐIỂM ĐÁNH GIÁ (1 - 5)
                        </label>
                        <input type="number"
                               name="soSao"
                               class="form-control text-center fw-bold fs-4"
                               min="1"
                               max="5"
                               value="5"
                               required>
                    </div>

                    <div class="mb-3 text-start">
                        <label class="form-label fw-bold small text-muted">
                            CẢM NHẬN CỦA BẠN
                        </label>
                        <textarea name="nhanXet"
                                  class="form-control"
                                  rows="3"
                                  placeholder="Ví dụ: Tập rất sung, tạ nặng hơn tuần trước..."></textarea>
                    </div>

                </div>

                <div class="modal-footer">
                    <button type="submit" class="btn btn-neon fw-bold w-100 text-dark">
                        GỬI ĐÁNH GIÁ
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<style>
    .star-label {
        font-size: 32px;
        color: #ccc;
        cursor: pointer;
        transition: 0.2s;
    }

        /* Hover sáng từ trái sang */
        .star-label:hover,
        .star-label:hover ~ .star-label {
            color: #ffc107;
        }

    /* Khi đã chọn */
    .rating-group input:checked ~ .star-label {
        color: #ffc107;
    }
</style>
<script>
    document.addEventListener("DOMContentLoaded", function () {
        const stars = document.querySelectorAll(".star");
        const input = document.getElementById("soSao");

        stars.forEach(star => {
            star.addEventListener("click", function () {
                let value = this.getAttribute("data-value");
                input.value = value;

                // reset màu tất cả sao
                stars.forEach(s => s.classList.remove("text-warning"));

                // tô vàng từ 1 → sao được chọn
                for (let i = 0; i < value; i++) {
                    stars[i].classList.add("text-warning");
                }
            });
        });
    });
</script>
