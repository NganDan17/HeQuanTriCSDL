@model Nhom05_Health_Fitness.Models.UserProfileViewModel

@{
    ViewBag.Title = "Hồ sơ cá nhân";
    Layout = "~/Views/Shared/_LayoutUser.cshtml";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow border-0 rounded-4 overflow-hidden">

                <div class="card-header bg-brand-teal text-white text-center py-4 position-relative">
                    <div class="mb-3 d-inline-block position-relative">
                        <div class="rounded-circle bg-white d-flex align-items-center justify-content-center shadow-sm"
                             style="width: 100px; height: 100px;">
                            <i class="fas fa-user fa-3x" style="color: var(--brand-teal);"></i>
                        </div>
                    </div>
                    <h3 class="fw-bold mb-0 text-uppercase">@Model.HoTen</h3>
                    <p class="small opacity-75 mb-0">@Model.Email</p>
                </div>

                <div class="card-body p-5 bg-white">
                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success"><i class="fas fa-check-circle me-2"></i>@TempData["Success"]</div>
                    }
                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger"><i class="fas fa-exclamation-triangle me-2"></i>@TempData["Error"]</div>
                    }

                    @using (Html.BeginForm("CapNhatHoSo", "User", FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()

                        <h5 class="text-muted fw-bold mb-4 border-bottom pb-2">
                            <i class="fas fa-info-circle me-2"></i>Thông tin cơ bản
                        </h5>

                        <div class="row g-3 mb-4">
                            <div class="col-md-12">
                                <label class="form-label fw-bold text-muted small">HỌ VÀ TÊN</label>
                                @Html.TextBoxFor(m => m.HoTen, new { @class = "form-control", required = "required" })
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-bold text-muted small">GIỚI TÍNH</label>
                                <select name="GioiTinh" class="form-select">
                                    <option value="Nam" @(Model.GioiTinh == "Nam" ? "selected" : "")>Nam</option>
                                    <option value="Nữ" @(Model.GioiTinh == "Nữ" ? "selected" : "")>Nữ</option>
                                    <option value="Khác" @(Model.GioiTinh == "Khác" ? "selected" : "")>Khác</option>
                                </select>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-bold text-muted small">NGÀY SINH</label>
                                <input type="date" name="NgaySinh" class="form-control"
                                       value="@(Model.NgaySinh.HasValue ? Model.NgaySinh.Value.ToString("yyyy-MM-dd") : "")">
                            </div>
                        </div>

                        <h5 class="text-muted fw-bold mb-4 border-bottom pb-2 pt-2">
                            <i class="fas fa-heartbeat me-2"></i>Chỉ số cơ thể
                        </h5>

                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <label class="form-label fw-bold text-muted small">CHIỀU CAO</label>
                                <div class="input-group">
                                    @Html.TextBoxFor(m => m.ChieuCao, new { @class = "form-control", type = "number", step = "0.01" })
                                    <span class="input-group-text bg-light">cm</span>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-bold text-muted small">CÂN NẶNG</label>
                                <div class="input-group">
                                    @Html.TextBoxFor(m => m.CanNang, new { @class = "form-control", type = "number", step = "0.01" })
                                    <span class="input-group-text bg-light">kg</span>
                                </div>
                            </div>
                        </div>

                        <div class="bg-light p-3 rounded mb-4 border">
                            <div class="row">
                                <div class="col-md-6">
                                    <small class="text-muted d-block">Tên đăng nhập</small>
                                    <strong>@Model.TenDangNhap</strong>
                                </div>
                                <div class="col-md-6 text-md-end">
                                    <small class="text-muted d-block">Trạng thái tài khoản</small>
                                    <span class="badge bg-success">Đang hoạt động</span>
                                </div>
                            </div>
                        </div>

                        <div class="d-grid">
                            <button type="submit" class="btn btn-neon btn-lg fw-bold shadow-sm text-dark">
                                <i class="fas fa-save me-2"></i> LƯU THAY ĐỔI
                            </button>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>