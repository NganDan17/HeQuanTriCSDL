<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>HEALTH Admin</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" />
    <link href="~/Content/ThuocTinhAdmin.css" rel="stylesheet" />

</head>
<body>
    <div class="page-container">
        <nav class="sidebar">
            <div class="sidebar-header">
                HEALTH Admin
            </div>
            <ul class="sidebar-menu">
                <li class="active">
                    <a href="@Url.Action("Admin_TrangChu","Admin")"><i class="fas fa-th-large"></i> Dashboard</a>
                </li>
                <li>
                    <a href="@Url.Action("Admin_DanhSachNguoiDung", "Admin")"><i class="fas fa-users"></i> Account & Staff</a>
                </li>
                <li>
                    <a href="#"><i class="fas fa-building"></i> Facilities</a>
                </li>
                <li>
                    <a href="#"><i class="fas fa-dollar-sign"></i> Finance & Services</a>
                </li>
                <li>
                    <a href="#"><i class="fas fa-chart-bar"></i> Reports</a>
                </li>
                <li>
                    <a href="#"><i class="fas fa-cogs"></i> System Jobs</a>
                </li>
                <li>
                    <a href="@Url.Action("Logout", "Account")"><i class="fas fa-cogs"></i> Đăng xuất</a>
                </li>
               
            </ul>
        </nav>

        <main class="main-content">
            <header class="top-bar">
                <div class="top-bar-left">

                </div>
                <div class="top-bar-right">
                    <div class="icon-button">
                        <i class="fas fa-bell"></i>
                    </div>
                    <div class="user-profile">
                        <i class="fas fa-user"></i>
                        <div class="user-info">
                            <div class="user-name">Admin</div>
                            <div class="user-role">Administrator</div>
                        </div>
                    </div>
                </div>
            </header>

            <div class="page-content">
                @RenderBody()
            </div>

            <div class="help-icon">
                ?
            </div>
        </main>
    </div>

    @RenderSection("scripts", required: false)
</body>
</html>