@model Nhom05_Health_Fitness.Models.ScheduleViewModel

@{
    ViewBag.Title = "Schedule Management";
    Layout = "~/Views/Shared/_LayoutHLV.cshtml";
}

<link href="~/Content/styleHLV.css" rel="stylesheet" />
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

<style>
    /* CSS Riêng cho trang Schedule */
    .schedule-container { color: #fff; font-family: 'Poppins', sans-serif; padding-bottom: 50px; }

    /* Header */
    .schedule-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 25px; }
    .schedule-header h2 { margin: 0; font-weight: 700; font-size: 28px; color: var(--text-color); }
    .schedule-header p { margin: 5px 0 0; color: var(--light-text); }

    /* Buttons */
    .btn-add-session {
        background-color: #a34c5f; /* Màu đỏ hồng */
        color: #fff; border: none; padding: 10px 20px;
        border-radius: 8px; font-weight: 600; cursor: pointer;
        display: flex; align-items: center; gap: 8px;
        transition: background 0.3s;
        text-decoration: none;
    }
    .btn-add-session:hover { background-color: #c76e81; color: #fff; }

    /* Summary Card (Màu be sáng) */
    .summary-card {
        background-color: #ffe4c4; /* Màu kem */
        color: #5a3a2a; border-radius: 12px; padding: 25px;
        margin-bottom: 40px; display: flex; align-items: center; gap: 20px;
        box-shadow: 0 4px 10px rgba(0,0,0,0.2);
    }
    .summary-icon { font-size: 30px; color: #a0522d; }
    .summary-text h4 { margin: 0 0 5px 0; font-size: 18px; font-weight: 700; }
    .summary-text span { font-size: 14px; opacity: 0.9; }

    /* Grid 2 cột */
    .schedule-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 30px; }
    .section-title { font-size: 18px; font-weight: 600; margin-bottom: 15px; color: #e0e0e0; }

    /* Session Card (Màu nâu đỏ tối) */
    .session-card {
        background-color: #5c2a3b; /* Nền card */
        border: 1px solid #800000; border-radius: 10px;
        padding: 20px; margin-bottom: 15px;
        display: flex; justify-content: space-between; align-items: center;
        transition: transform 0.2s;
    }
    .session-card:hover { transform: translateY(-2px); border-color: #a34c5f; }

    .session-info h5 { margin: 0 0 5px 0; font-size: 16px; color: #fff; }
    .session-time { color: #ccc; font-size: 13px; display: block; margin-bottom: 3px; }
    .session-duration { color: #a34c5f; font-weight: 600; font-size: 13px; } /* Chữ thời lượng màu hồng */

    .btn-edit { color: #a34c5f; cursor: pointer; font-size: 14px; text-decoration: none; }
    .btn-edit:hover { text-decoration: underline; color: #fff; }

    /* Modal Styles (Tùy chỉnh Bootstrap Modal) */
    .modal-content {
        background-color: #ffe4c4; /* Nền modal màu kem */
        color: #3e2723; border-radius: 15px; border: none;
    }
    .modal-header { border-bottom: 1px solid #dcbfa3; }
    .modal-title { font-weight: 700; color: #5a3a2a; }
    .btn-close { filter: invert(1); } /* Close button màu tối */

    .form-label-custom { font-weight: 600; font-size: 14px; margin-bottom: 5px; display: block; color: #5a3a2a; }
    .form-control-custom {
        width: 100%; padding: 10px; border-radius: 8px;
        border: 1px solid #dcbfa3; background-color: #fff; color: #333;
    }

    .modal-footer { border-top: 1px solid #dcbfa3; }
    .btn-save { background-color: #800000; color: #fff; border: none; padding: 10px 20px; border-radius: 8px; font-weight: 600; }
    .btn-save:hover { background-color: #a34c5f; }
    .btn-cancel-modal { background-color: #999; color: #fff; border: none; padding: 10px 20px; border-radius: 8px; margin-right: 10px; }

</style>

<div class="schedule-container">

    <div class="schedule-header">
        <div>
            <h2>Schedule Management</h2>
            <p>Manage your training sessions</p>
        </div>
        <button type="button" class="btn-add-session" data-bs-toggle="modal" data-bs-target="#addSessionModal">
            <i class="fas fa-plus"></i> Add New Session
        </button>
    </div>

    <div class="summary-card">
        <i class="fas fa-clock summary-icon"></i>
        <div class="summary-text">
            <h4>Total Teaching Hours (This Month): @Model.TotalTeachingHours hrs</h4>
            <span>@Model.CompletedSessions sessions completed, @Model.UpcomingSessions upcoming</span>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
    }

    <div class="schedule-grid">

        <div>
            <div class="section-title">Upcoming Sessions</div>
            @if (Model.UpcomingList.Any())
            {
                foreach (var item in Model.UpcomingList)
                {
                   <div class="session-card">
                       <div class="session-info">
                           <h5>@item.StudentName</h5>
                           <span class="session-time">@item.Date.ToString("yyyy-MM-dd") at @item.Time</span>
                           <span class="session-duration">@item.Duration min</span>
                       </div>

                       <a href="#" class="btn-edit"
                          onclick="openEditModal('@item.LichID', '@item.StudentName', '@item.Date.ToString("yyyy-MM-dd")', '@item.Duration')">
                           Edit
                       </a>
                   </div>
                }
            }
            else
            {
                <p style="color: #999;">No upcoming sessions.</p>
            }
        </div>

        <div>
            <div class="section-title">Completed Sessions</div>
            @if (Model.CompletedList.Any())
            {
                foreach (var item in Model.CompletedList)
                {
                    <div class="session-card" style="opacity: 0.8;">
                        <div class="session-info">
                            <h5>@item.StudentName</h5>
                            <span class="session-time">@item.Date.ToString("yyyy-MM-dd") at @item.Time</span>
                            <span class="session-duration">@item.Duration min</span>
                        </div>
                    </div>
                }
            }
            else
            {
                <p style="color: #999;">No completed sessions.</p>
            }
        </div>
    </div>
</div>

<div class="modal fade" id="addSessionModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Add New Training Session</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            @using (Html.BeginForm("AddSchedule", "HLV", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                <div class="modal-body">

                    <div class="mb-3">
                        <label class="form-label-custom">Student</label>
                        @Html.DropDownListFor(m => m.SelectedStudentId, Model.StudentsList, "Select student", new { @class = "form-control-custom", required = "required" })
                    </div>

                    <div class="mb-3">
                        <label class="form-label-custom">Date</label>
                        @Html.TextBoxFor(m => m.Date, "{0:yyyy-MM-dd}", new { @class = "form-control-custom", type = "date", required = "required" })
                    </div>

                    <div class="row">
                        <div class="col-6 mb-3">
                            <label class="form-label-custom">Time</label>
                            <input type="time" name="Time" class="form-control-custom" value="09:00" />
                        </div>
                        <div class="col-6 mb-3">
                            <label class="form-label-custom">Duration (min)</label>
                            @Html.TextBoxFor(m => m.Duration, new { @class = "form-control-custom", type = "number", min = "30", step = "15" })
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label-custom">Content / Notes</label>
                        @Html.TextAreaFor(m => m.Notes, new { @class = "form-control-custom", rows = "2", placeholder = "Session details..." })
                    </div>

                </div>
                <div class="modal-footer">
                    <button type="button" class="btn-cancel-modal" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn-save">Save Session</button>
                </div>
            }
        </div>
    </div>
</div>

<div class="modal fade" id="editSessionModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Edit Training Session</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            @using (Html.BeginForm("EditSchedule", "HLV", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                <input type="hidden" id="Edit_LichID" name="LichID" />

                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label-custom">Student</label>
                        <input type="text" id="Edit_StudentName" class="form-control-custom" readonly style="background-color: #eee;" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label-custom">Date</label>
                        @Html.TextBoxFor(m => m.Date, "{0:yyyy-MM-dd}", new { @class = "form-control-custom", type = "date", required = "required", id = "Edit_Date" })
                    </div>

                    <div class="row">
                        <div class="col-6 mb-3">
                            <label class="form-label-custom">Time</label>
                            <input type="time" name="Time" class="form-control-custom" value="09:00" />
                        </div>
                        <div class="col-6 mb-3">
                            <label class="form-label-custom">Duration (min)</label>
                            @Html.TextBoxFor(m => m.Duration, new { @class = "form-control-custom", type = "number", min = "30", step = "15", id = "Edit_Duration" })
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label-custom">Content / Notes</label>
                        @Html.TextAreaFor(m => m.Notes, new { @class = "form-control-custom", rows = "2", placeholder = "Update details..." })
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn-cancel-modal" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn-save">Update Session</button>
                </div>
            }
        </div>
    </div>
</div>

<script>
    function openEditModal(id, name, date, duration) {
        // 1. Gán dữ liệu từ nút bấm vào các ô trong Modal
        document.getElementById('Edit_LichID').value = id;
        document.getElementById('Edit_StudentName').value = name;
        document.getElementById('Edit_Date').value = date;
        document.getElementById('Edit_Duration').value = duration;

        // 2. Mở Modal bằng Bootstrap
        var myModal = new bootstrap.Modal(document.getElementById('editSessionModal'));
        myModal.show();
    }
</script>