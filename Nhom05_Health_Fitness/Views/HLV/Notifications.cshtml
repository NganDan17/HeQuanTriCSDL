@model Nhom05_Health_Fitness.Models.DashboardHLVViewModel

@{
    ViewBag.Title = "Thông Báo";
    Layout = "~/Views/Shared/_LayoutHLV.cshtml";
}

<link href="~/Content/styleHLV.css" rel="stylesheet" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">

<style>
    /* --- CSS Riêng cho trang Notification --- */
    .noti-container {
        max-width: 900px;
        margin: 0 auto;
        color: #fff;
        font-family: 'Poppins', sans-serif;
        padding-bottom: 50px;
    }

    /* Header */
    .noti-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 20px;
        border-bottom: 1px solid rgba(255,255,255,0.1);
        padding-bottom: 15px;
        flex-wrap: wrap;
        gap: 15px;
    }

    .noti-header-text h2 {
        margin: 0;
        font-size: 26px;
        font-weight: 700;
        color: var(--text-color);
    }

    .noti-header-text p {
        margin: 5px 0 0;
        color: var(--light-text);
        font-size: 14px;
    }

    /* Nút bấm */
    .header-actions {
        display: flex;
        gap: 10px;
    }

    .btn-action {
        padding: 8px 16px;
        border-radius: 20px;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
        transition: 0.3s;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }

    .btn-add-noti {
        background-color: #27ae60; /* Màu xanh lá */
        color: #fff;
        border: none;
    }

        .btn-add-noti:hover {
            background-color: #219150;
            color: #fff;
        }

    .btn-mark-all {
        background-color: transparent;
        color: var(--accent-red);
        border: 1px solid var(--accent-red);
    }

        .btn-mark-all:hover {
            background-color: var(--accent-red);
            color: #fff;
        }

    /* Notification Card */
    .noti-card {
        background-color: #ffe4c4; /* MÀU BE SÁNG */
        border-radius: 12px;
        padding: 20px;
        margin-bottom: 15px;
        display: flex;
        align-items: flex-start;
        gap: 20px;
        color: #3e2723;
        box-shadow: 0 4px 10px rgba(0,0,0,0.2);
        border-left: 6px solid #ccc;
        transition: transform 0.2s ease;
    }

        .noti-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 15px rgba(0,0,0,0.3);
        }

        /* Phân loại màu viền */
        .noti-card.warning {
            border-left-color: #d35400;
        }

        .noti-card.calendar {
            border-left-color: #8d4e5a;
        }

        .noti-card.success {
            border-left-color: #27ae60;
        }

        .noti-card.info {
            border-left-color: #2980b9;
        }

    /* Icon */
    .icon-wrapper {
        width: 45px;
        height: 45px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 20px;
        flex-shrink: 0;
        background-color: rgba(255,255,255,0.6);
    }

    .warning .icon-wrapper {
        color: #d35400;
    }

    .calendar .icon-wrapper {
        color: #8d4e5a;
    }

    .success .icon-wrapper {
        color: #27ae60;
    }

    .info .icon-wrapper {
        color: #2980b9;
    }

    /* Nội dung */
    .noti-content {
        flex-grow: 1;
    }

        .noti-content h4 {
            margin: 0 0 5px 0;
            font-size: 16px;
            font-weight: 700;
            color: #4e342e;
        }

        .noti-content p {
            margin: 0 0 8px 0;
            font-size: 14px;
            color: #5d4037;
            line-height: 1.4;
        }

    .noti-time {
        font-size: 12px;
        color: #8d6e63;
        font-weight: 500;
    }

    /* Actions */
    .noti-actions {
        display: flex;
        flex-direction: column;
        gap: 10px;
        color: #a1887f;
    }

        .noti-actions i {
            cursor: pointer;
            transition: 0.2s;
            font-size: 16px;
        }

        .noti-actions .fa-check:hover {
            color: #27ae60;
            transform: scale(1.2);
        }

        .noti-actions .fa-times:hover {
            color: #c0392b;
            transform: scale(1.2);
        }

    /* Empty State */
    .empty-state {
        text-align: center;
        padding: 60px;
        color: var(--light-text);
    }

        .empty-state i {
            font-size: 50px;
            margin-bottom: 15px;
            opacity: 0.3;
        }

    /* Modal Styles (Ghi đè để hiển thị tốt trên nền tối) */
    .modal-content {
        color: #333;
    }
</style>

<div class="noti-container">

    <div class="noti-header">
        <div class="noti-header-text">
            <h2>Trung Tâm Thông Báo</h2>
            <p>Bạn có @Model.UnreadCount thông báo mới.</p>
        </div>
        <div class="header-actions">
            <button type="button" class="btn-action btn-add-noti" data-bs-toggle="modal" data-bs-target="#addNotiModal">
                <i class="fas fa-plus"></i> Thêm nhắc nhở
            </button>

            @if (Model.Notifications.Any())
            {
                <button class="btn-action btn-mark-all">Đã đọc tất cả</button>
            }
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success" style="background: #d4edda; color: #155724; border: none;">
            <i class="fas fa-check-circle"></i> @TempData["SuccessMessage"]
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger" style="background: #f8d7da; color: #721c24; border: none;">
            <i class="fas fa-exclamation-circle"></i> @TempData["ErrorMessage"]
        </div>
    }

    <div class="noti-list">
        @if (Model.Notifications != null && Model.Notifications.Any())
        {
            foreach (var item in Model.Notifications)
            {
                <div class="noti-card @item.Type">
                    <div class="icon-wrapper">
                        @if (item.Type == "warning")
                        {<i class="fas fa-exclamation-triangle"></i> }
                        else if (item.Type == "calendar")
                        { <i class="far fa-calendar-alt"></i> }
                        else if (item.Type == "success")
                        { <i class="fas fa-award"></i> }
                        else
                        { <i class="fas fa-info-circle"></i>}
                    </div>

                    <div class="noti-content">
                        <h4>@item.Title</h4>
                        <p>@item.Message</p>
                        <span class="noti-time">
                            <i class="far fa-clock"></i> @item.TimeAgo
                        </span>
                    </div>

                    <div class="noti-actions">
                        <i class="fas fa-check" title="Đánh dấu đã đọc"></i>
                        <i class="fas fa-times" title="Xóa"></i>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="empty-state">
                <i class="far fa-bell-slash"></i>
                <p>Hiện tại không có thông báo nào.</p>
            </div>
        }
    </div>

</div>

<div class="modal fade" id="addNotiModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" style="font-weight: 700;">Tạo nhắc nhở cá nhân</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            @using (Html.BeginForm("AddNotification", "HLV", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label" style="font-weight: 600;">Nội dung nhắc nhở</label>
                        <textarea name="message" class="form-control" rows="3" required placeholder="Ví dụ: Soạn giáo án cho lớp chiều nay..."></textarea>
                    </div>

                    <div class="mb-3">
                        <label class="form-label" style="font-weight: 600;">Ngày nhắc</label>
                        <input type="date" name="date" class="form-control" required
                               value="@DateTime.Now.ToString("yyyy-MM-dd")"
                               min="@DateTime.Now.ToString("yyyy-MM-dd")" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-success" style="background-color: #27ae60; border: none;">Lưu nhắc nhở</button>
                </div>
            }
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>